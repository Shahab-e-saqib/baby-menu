    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "acp-mock": "1.1.0",
    "electron": "42.1.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
